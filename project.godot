; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="TENKAI"
config/description="TENKAI - Prototype pre-alpha : vertical slice action RPG 3D (Mondholm)."
config/version="0.6.0-playable"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"

[autoload]

Bootstrap="*res://scripts/core/Bootstrap.gd"
GameState="*res://scripts/core/GameState.gd"
MissionManager="*res://scripts/core/MissionManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
VFXManager="*res://scripts/core/VFXManager.gd"
DebugConsole="*res://scripts/core/DebugConsole.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[physics]

3d/default_gravity=9.8
3d/default_linear_damp=0.12
3d/default_angular_damp=0.2

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Hurtbox"
3d_physics/layer_5="Hitbox"
3d_physics/layer_6="Interact"
3d_physics/layer_7="Boss"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.24, 1)
